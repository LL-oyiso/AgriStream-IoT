{
  "version": "2.0",
  "logging": {
    "fileLoggingMode": "always",
    "logLevel": {
      "default": "Information",
      "Azure.Core": "Warning"
    }
  },
  "extensions": {
    "queues": {
      "batchSize": 16,
      "newBatchThreshold": 8,
      "maxPollingInterval": "00:00:02",
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:00:30"
    }
  }
}
