@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}
<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="h4 mb-3">Create an account</h1>
        <form asp-action="Register" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" autocomplete="username" />
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
                <div class="form-text">At least 8 characters. Stored as a salted hash.</div>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" autocomplete="new-password" />
            </div>
            <div class="mb-3">
                <label asp-for="Role" class="form-label"></label>
                <select asp-for="Role" class="form-select">
                    <option value="Farmer">Farmer</option>
                    <option value="Agronomist">Agronomist</option>
                </select>
                <div class="form-text">An Admin assigns the Admin role.</div>
            </div>
            <button type="submit" class="btn btn-success">Register</button>
            <a class="btn btn-link" asp-action="Login">Back to sign in</a>
        </form>
    </div>
</div>
